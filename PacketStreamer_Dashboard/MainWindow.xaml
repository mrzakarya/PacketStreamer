<Window x:Class="PacketStreamer_Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:PacketStreamer_Dashboard"
        Title="PacketStreamer Dashboard" 
        Height="800" Width="1200"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <local:ProtocolToColorConverter x:Key="ProtocolToColorConverter"/>
        <local:ProtocolToBackgroundConverter x:Key="ProtocolToBackgroundConverter"/>
        <!-- ✅ استایل Progress Bar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border BorderThickness="0" 
                                CornerRadius="4" 
                                Background="#1E1E1E"
                                Padding="0">
                            <Grid>
                                <Rectangle x:Name="PART_Track" 
                                           Fill="#1E1E1E" 
                                           RadiusX="4" 
                                           RadiusY="4"/>
                                <Rectangle x:Name="PART_Indicator" 
                                           Fill="{TemplateBinding Foreground}" 
                                           RadiusX="4" 
                                           RadiusY="4" 
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ NEW: استایل TabControl (تم تیره) -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="#2D2D30" 
                                CornerRadius="8,8,0,0"
                                Margin="0,0,2,0"
                                Padding="15,8">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#3A3A3D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4A4A4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ✅ NEW: استایل DataGrid (تم تیره) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#2D2D30"/>
            <Setter Property="AlternatingRowBackground" Value="#333337"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#444444"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>

        <!-- ✅ NEW: استایل هدر DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#00D4FF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ✅ NEW: استایل سلول DataGrid -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#00D4FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ NEW: استایل Row -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005577"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ NEW: استایل ScrollBar (تم تیره) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- هدر -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🚀 PacketStreamer" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#00D4FF"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Real-time Network Packet Analyzer" 
                       FontSize="14" 
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- محتوای اصلی با TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- تب ۱: Dashboard -->
            <TabItem Header="📊 Dashboard">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- نمودار پای -->
                    <Border Grid.Column="0" 
                            Background="#2D2D30" 
                            CornerRadius="10" 
                            Margin="0,0,10,0"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="Protocol Distribution" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,10"/>

                            <lvc:PieChart x:Name="ProtocolPieChart" 
                                          Grid.Row="1" 
                                          InnerRadius="20" 
                                          StartingRotationAngle="0" 
                                          Hoverable="False" 
                                          DataTooltip="{x:Null}"
                                          AnimationsSpeed="0">
                                <lvc:PieChart.ChartLegend>
                                    <lvc:DefaultLegend Foreground="White"/>
                                </lvc:PieChart.ChartLegend>
                            </lvc:PieChart>
                        </Grid>
                    </Border>

                    <!-- آمار و لیست پروتکل‌ها -->
                    <Border Grid.Column="1" 
                            Background="#2D2D30" 
                            CornerRadius="10" 
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="Live Statistics" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                <TextBlock x:Name="TotalPacketsText" 
                                           Text="Total Packets: 0" 
                                           FontSize="16"
                                           Foreground="#00D4FF"
                                           Margin="0,0,0,5"/>
                                <TextBlock x:Name="PacketsPerSecondText" 
                                           Text="Packets/sec: 0" 
                                           FontSize="16"
                                           Foreground="#00FF88"/>
                            </StackPanel>

                            <ListBox x:Name="ProtocolListBox" 
                                     Grid.Row="2"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#3A3A3D" 
                                                CornerRadius="6" 
                                                Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding Protocol}" 
                                                               Foreground="{Binding Color}"
                                                               FontSize="14" 
                                                               FontWeight="Bold"/>

                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding CountText}" 
                                                               Foreground="White" 
                                                               FontSize="13"/>

                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding PercentageText}" 
                                                               Foreground="#00FF88" 
                                                               FontSize="14" 
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>

                                                <ProgressBar Grid.Row="1" 
                                                             Value="{Binding Percentage}" 
                                                             Maximum="100"
                                                             Height="8"
                                                             Foreground="{Binding Color}"
                                                             Background="#1E1E1E"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- تب ۲: Packet List -->
            <TabItem Header="📋 Packet List">
                <Border Background="#2D2D30" CornerRadius="10" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Packet Inspector" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>

                        <!-- نوار فیلتر (همان کد قبلی) -->
                        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#333333" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🔎 Global Search:" Foreground="#00D4FF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="FilterGlobal" Width="300" Height="32" Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source IP" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Dest IP" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Src Port" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Dst Port" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Protocol" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="5" Text="Length" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>

                                    <TextBox x:Name="FilterSrcIp" Grid.Row="1" Grid.Column="0" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="FilterDstIp" Grid.Row="1" Grid.Column="1" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="FilterSrcPort" Grid.Row="1" Grid.Column="2" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="FilterDstPort" Grid.Row="1" Grid.Column="3" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,5,0"/>

                                    <ComboBox x:Name="FilterProto" Grid.Row="1" Grid.Column="4" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,5,0" SelectedIndex="0">
                                        <ComboBoxItem Content="All"/>
                                        <ComboBoxItem Content="TCP"/>
                                        <ComboBoxItem Content="UDP"/>
                                        <ComboBoxItem Content="ICMP"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>

                                    <TextBox x:Name="FilterLength" Grid.Row="1" Grid.Column="5" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1" VerticalContentAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="FilterResultText" Text="Showing all packets" Foreground="#00FF88" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>



                                    <Button Content="Clear" Width="100" Height="32" Background="#3A3A3D" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="ClearFilter_Click"/>
                                    <Button Content="Apply" Width="120" Height="32" Background="#00D4FF" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="ApplyFilter_Click"/>

                                    <!-- ✅ NEW: دکمه‌های Export -->
                                    <Button Content="💾 Export CSV" Width="110" Height="32" Background="#FF9500" Foreground="Black" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="8,0,8,0" Click="ExportCsv_Click" ToolTip="Export filtered packets to CSV file"/>

                                    <Button Content="📦 Export PCAP" Width="110" Height="32" Background="#AA00FF" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="ExportPcap_Click" ToolTip="Export raw packets to PCAP (Wireshark format)"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- جدول پکت‌ها -->
                        <DataGrid x:Name="PacketDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single" SelectionChanged="PacketDataGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    <Setter Property="BorderBrush" Value="{Binding Protocol, Converter={StaticResource ProtocolToColorConverter}}"/>
                                    <Setter Property="Background" Value="{Binding Protocol, Converter={StaticResource ProtocolToBackgroundConverter}}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#005577"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3A3A3D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="90"/>
                                <DataGridTextColumn Header="Source IP" Binding="{Binding SrcIP}" Width="120"/>
                                <DataGridTextColumn Header="Dest IP" Binding="{Binding DstIP}" Width="120"/>
                                <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Protocol, Converter={StaticResource ProtocolToColorConverter}}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Src Port" Binding="{Binding SrcPort}" Width="70"/>
                                <DataGridTextColumn Header="Dst Port" Binding="{Binding DstPort}" Width="70"/>
                                <DataGridTextColumn Header="Len" Binding="{Binding Length}" Width="50"/>
                                <DataGridTextColumn Header="Data Preview" Binding="{Binding PayloadPreview}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- ✅ NEW: Splitter برای تغییر اندازه -->
                        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#00D4FF" Cursor="SizeNS"/>

                        <!-- ✅ NEW: پنل جزئیات پکت -->
                        <Border Grid.Row="4" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,5,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- سمت چپ: ساختار هدرها -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="📋 Packet Details" FontSize="14" FontWeight="SemiBold" Foreground="#00D4FF" Margin="0,0,0,10"/>

                                    <TreeView x:Name="PacketDetailsTree" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="True"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                </Grid>

                                <!-- Splitter عمودی -->
                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#00D4FF" Cursor="SizeWE"/>

                                <!-- سمت راست: Hex + ASCII View -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="🔢 Hex + ASCII Dump" FontSize="14" FontWeight="SemiBold" Foreground="#00D4FF" Margin="0,0,0,10"/>

                                    <TextBox x:Name="HexDumpText" Grid.Row="1" 
                                 Background="#0D0D0D" Foreground="#00FF88" 
                                 FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Padding="10"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>


            <!-- ✅ NEW: تب ۳: Time Series -->
            <TabItem Header="📈 Time Series">
                <Border Background="#2D2D30" CornerRadius="10" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- عنوان -->
                        <TextBlock Grid.Row="0" Text="📈 Network Traffic Over Time" 
                       FontSize="18" FontWeight="SemiBold" 
                       Foreground="White" Margin="0,0,0,15"/>

                        <!-- آمار PPS -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6" Margin="0,0,8,0" BorderBrush="#00FF88" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦 Current: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CurrentPpsText" Text="0" Foreground="#00FF88" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" pps" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Peak: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PeakPpsText" Text="0" Foreground="#FF4444" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Avg: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AvgPpsText" Text="0" Foreground="#00D4FF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- نمودار PPS -->
                        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📦 Packets Per Second (PPS)" 
                               Foreground="#00FF88" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <lvc:CartesianChart x:Name="TimeSeriesChart" Grid.Row="1"
                                        DisableAnimations="True" Hoverable="False">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Seconds ago" Foreground="White">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Stroke="#333333"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Packets" Foreground="#00FF88" MinValue="0">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Stroke="#333333"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </Grid>
                        </Border>

                        <!-- نمودار BPS -->
                        <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📊 Bytes Per Second (BPS)" 
                   Foreground="#00D4FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <lvc:CartesianChart x:Name="TimeSeriesChart2" Grid.Row="1"
                            DisableAnimations="True" Hoverable="False">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Seconds ago" Foreground="White">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Stroke="#333333"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Bytes" Foreground="#00D4FF" MinValue="0">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Stroke="#333333"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </Grid>
                        </Border>

                        <!-- آمار BPS -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Top">
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6" Margin="0,0,8,0" BorderBrush="#00D4FF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 Current: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CurrentBpsText" Text="0 B/s" Foreground="#00D4FF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Peak: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PeakBpsText" Text="0 B/s" Foreground="#FF4444" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Avg: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AvgBpsText" Text="0 B/s" Foreground="#00D4FF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6">
                                <TextBlock x:Name="TotalBytesText" Text="Total: 0 B" Foreground="#FFD700" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>


            <!-- ✅ NEW: تب ۴: Top Talkers -->
            <TabItem Header="👑 Top Talkers">
                <Border Background="#2D2D30" CornerRadius="10" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- هدر و فیلتر حالت -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="👑 Top Talkers" 
                           FontSize="18" FontWeight="SemiBold" 
                           Foreground="White" Margin="0,0,20,0"/>

                            <TextBlock Text="Mode:" Foreground="#AAAAAA" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="TalkerModeCombo" 
                          Width="150" Height="30" 
                          Background="#2D2D30" Foreground="White" 
                          BorderBrush="#444444" BorderThickness="1"
                          SelectedIndex="0"
                          SelectionChanged="TalkerModeCombo_SelectionChanged">
                                <ComboBoxItem Content="All IPs"/>
                                <ComboBoxItem Content="Source IPs Only"/>
                                <ComboBoxItem Content="Dest IPs Only"/>
                            </ComboBox>

                            <TextBlock Text="  💡 Click any IP to filter packets" 
                           Foreground="#666666" FontSize="12" 
                           VerticalAlignment="Center" FontStyle="Italic"/>
                        </StackPanel>

                        <!-- دو ستون: Source و Dest -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ستون چپ: Top Source IPs -->
                            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="📤 Top Source IPs" 
                                   FontSize="15" FontWeight="SemiBold" 
                                   Foreground="#00D4FF" Margin="0,0,0,10"/>

                                    <ListBox x:Name="TopSourceList" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="TopIpList_MouseDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2D2D30" CornerRadius="6" Padding="10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="60"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Rank}" 
                                                           Foreground="#FFD700" FontWeight="Bold" FontSize="14"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding IP}" 
                                                           Foreground="White" FontSize="13" FontFamily="Consolas"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" 
                                                           Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PercentageText}" 
                                                           Foreground="#00FF88" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Value="{Binding Percentage}" 
                                                         Maximum="100" Height="6"
                                                         Foreground="#00D4FF" Background="#1E1E1E"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- ستون راست: Top Dest IPs -->
                            <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="📥 Top Destination IPs" 
                                   FontSize="15" FontWeight="SemiBold" 
                                   Foreground="#FF9500" Margin="0,0,0,10"/>

                                    <ListBox x:Name="TopDestList" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="TopIpList_MouseDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2D2D30" CornerRadius="6" Padding="10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="60"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Rank}" 
                                                           Foreground="#FFD700" FontWeight="Bold" FontSize="14"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding IP}" 
                                                           Foreground="White" FontSize="13" FontFamily="Consolas"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" 
                                                           Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PercentageText}" 
                                                           Foreground="#00FF88" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Value="{Binding Percentage}" 
                                                         Maximum="100" Height="6"
                                                         Foreground="#FF9500" Background="#1E1E1E"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>


            <!-- ✅ NEW: تب ۵: Detected Files -->
            <TabItem Header="📁 Detected Files">
                <Border Background="#2D2D30" CornerRadius="10" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📁 Detected Files and Domains" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,20,0"/>

                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐 HTTP: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HttpCountText" Text="0" Foreground="#00D4FF" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍 DNS: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DnsCountText" Text="0" Foreground="#FFAA00" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E1E1E" CornerRadius="6" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 TLS: " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TlsCountText" Text="0" Foreground="#00FF88" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ListBox x:Name="DetectedFilesList" Grid.Row="1"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="DetectedFilesList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" CornerRadius="6" Padding="12"
                                BorderBrush="{Binding TypeColor}" BorderThickness="2,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" 
                                           FontSize="20" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                               Foreground="White" FontSize="14" 
                                               FontWeight="SemiBold" FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,0">
                                        <Run Text="{Binding SrcIP, Mode=OneWay}"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding DstIP, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Ports}" 
                                           Foreground="#AAAAAA" FontSize="12" 
                                           FontFamily="Consolas" VerticalAlignment="Center"/>

                                            <Border Grid.Column="3" Background="#2D2D30" 
                                        CornerRadius="4" Padding="6,2" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}" 
                                               Foreground="{Binding TypeColor}" 
                                               FontWeight="Bold" FontSize="12"/>
                                            </Border>

                                            <TextBlock Grid.Column="4" Text="{Binding HitCountText}" 
                                           Foreground="#00FF88" FontSize="13" 
                                           FontWeight="Bold" VerticalAlignment="Center" 
                                           HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ✅ NEW: تب فایل‌های ذخیره‌شده -->
            <TabItem Header="💾 Captured Files">
                <Border Background="#2D2D30" CornerRadius="10" Margin="0,10,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="💾 Locally Saved Files (HTTP Only)" 
                           FontSize="18" FontWeight="SemiBold" 
                           Foreground="White" Margin="0,0,20,0"/>
                            <TextBlock Text="💡 Double-click to open file in default app" 
                           Foreground="#AAAAAA" FontSize="12" 
                           VerticalAlignment="Center" FontStyle="Italic"/>
                        </StackPanel>

                        <DataGrid x:Name="CapturedFilesGrid" Grid.Row="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#2D2D30" Foreground="White"
                      BorderThickness="0" RowBackground="#2D2D30"
                      AlternatingRowBackground="#333337"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444444"
                      MouseDoubleClick="CapturedFilesGrid_MouseDoubleClick">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#005577"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3A3A3D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Icon" Binding="{Binding FileIcon}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="18"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="200"/>
                                <DataGridTextColumn Header="Content Type" Binding="{Binding ContentType}" Width="150"/>
                                <DataGridTextColumn Header="Source IP" Binding="{Binding SourceIP}" Width="120"/>
                                <DataGridTextColumn Header="Dest IP" Binding="{Binding DestIP}" Width="120"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding FileSizeText}" Width="80"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
            
            
        </TabControl>

        <!-- دکمه شروع/انتخاب کارت شبکه -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <!-- ✅ NEW: تنظیم ظرفیت بافر -->
            <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                <TextBlock Text="Buffer Capacity (packets)" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="CapacityTextBox" 
                 Width="150" Height="30" 
                 Background="#2D2D30" Foreground="White" 
                 BorderBrush="#444444" BorderThickness="1"
                 VerticalContentAlignment="Center"
                 Text="10000"
                 ToolTip="Number of packets to keep in memory (1000 - 10,000,000)"/>
            </StackPanel>

            <Button Content="Apply" Width="80" Height="30" 
            Background="#FF9500" Foreground="Black"
            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
            Margin="0,0,10,0" VerticalAlignment="Bottom"
            Click="ApplyCapacity_Click"/>

            <ComboBox x:Name="InterfaceComboBox" Width="350" Height="35" FontSize="14" Margin="0,0,10,0"/>

            <Button x:Name="StartButton" Content="▶ Start Capture" Width="150" Height="35"
            FontSize="14" FontWeight="SemiBold" Background="#00D4FF" Foreground="Black"
            BorderThickness="0" Cursor="Hand" Click="StartButton_Click"/>
        </StackPanel>
    </Grid>
</Window>